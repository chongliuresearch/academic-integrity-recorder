{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "溯研·学术研究过程诚信记录仪",
  "version": "0.1.0",
  "identifier": "org.openresearch.integrity-recorder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "溯研 · Research Provenance",
      "width": 1360,
      "height": 860,
      "minWidth": 1040,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "Voluntary tamper-evident research process recorder",
    "longDescription": "A local-first recorder for voluntary, reviewable academic research process evidence. Not an academic integrity certification."
  }
}
