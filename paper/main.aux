\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Local-first architecture. Evidence flows from platform capture adapters into a Rust evidence core that maintains a tamper-evident hash chain under an \textsc  {Ed25519}\xspace  device signer, is persisted in an immutable local store, exported as a two-layer \textsc  {Evidence Package~v1}\xspace  , and verified entirely offline. No telemetry leaves the device.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:arch}{{1}{4}{Local-first architecture. Evidence flows from platform capture adapters into a Rust evidence core that maintains a tamper-evident hash chain under an \ed device signer, is persisted in an immutable local store, exported as a two-layer \evpkg , and verified entirely offline. No telemetry leaves the device}{figure.1}{}}
